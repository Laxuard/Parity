APP_NAME = Parity
DEBUG = True

# ==============================================================================
# DATABASE URL SPECIFICATION (RFC 1738 / SQLAlchemy Format)
#
# Syntax:
#   <dialect>+<driver>://<username>:<password>@<host>:<port>/<database_name>?<options>
#
# Breakdown:
#   - <dialect>:        The database system ("postgresql", "mysql", "sqlite")
#   - <driver>:         The Python client driver ("asyncpg", "psycopg", "asyncmy")
#   - <username>:       Database user / role name (e.g. "postgres", "laxuard")
#   - <password>:       User password (URL-encode special characters like @, :, #)
#   - <host>:           Server IP or domain ("localhost", "127.0.0.1", "db.example.com")
#   - <port>:           Port number (PostgreSQL default is 5432)
#   - <database_name>:  Target database name (e.g. "parity_db")
#   - <options>:        Optional connection parameters (e.g. "?ssl=require", "?timeout=10")
#
# Examples:
#   - Async (Default):  postgresql+asyncpg://laxuard:my_password@localhost:5432/parity_db
#   - Without Password: postgresql+asyncpg://laxuard@localhost:5432/parity_db
#   - Sync Fallback:    postgresql+psycopg://laxuard:my_password@localhost:5432/parity_db
# ==============================================================================
DATABASE_URL = ?
